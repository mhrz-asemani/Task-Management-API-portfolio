NODE_ENV=development
PORT=3000

JWT_SECRET=replace_with_at_least_32_characters

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# When running the API/tests from Windows, connect to the Docker-published port.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace_with_your_docker_postgres_password
DB_NAME=todo_db

# Set to true only if the hosted PostgreSQL provider requires TLS.
DB_SSL=false

FRONTEND_ORIGIN=http://localhost:58585

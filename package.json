{
  "name": "task-management-api",
  "version": "1.0.0",
  "description": "Task management REST API built with Express, TypeScript, and PostgreSQL",
  "main": "index.js",
  "scripts": {
    "test": "cross-env NODE_ENV=test jest",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:fast": "tsgo --noEmit",
    "db:migrate": "node dist/migrate.js",
    "db:migrate:test": "cross-env NODE_ENV=test node dist/migrate.js",
    "start": "node dist/server.js",
    "pretest": "node scripts/validate-openapi.js",
    "validate:openapi": "node scripts/validate-openapi.js"
  },
  "keywords": [
    "task-management",
    "express",
    "typescript",
    "postgresql",
    "rest-api"
  ],
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "cross-env": "^10.1.0",
    "jest": "^30.5.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "bcrypt@6.0.0": true,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.6.0": true
  }
}
